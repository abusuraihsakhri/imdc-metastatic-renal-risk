# IMDC Metastatic Renal Risk - Environment Configuration
# Copy this file to .env and set your own values

# HMAC-SHA256 Audit Trail Secret Key
# IMPORTANT: Use a strong, randomly generated key in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# AUDIT_SECRET_KEY=<replace-with-a-unique-random-32-byte-or-longer-key>

# LLM Model Provider (mock, ollama, claude, openai)
APP_ENV=development
MODEL_PROVIDER=mock

# API Server Configuration
HOST=127.0.0.1
PORT=8000
