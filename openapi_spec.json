{
  "openapi": "3.1.0",
  "info": {
    "title": "Imdc Metastatic Renal Risk API",
    "description": "Six-factor IMDC/Heng prognostic scoring and separate generic demonstration audit endpoints.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Air-gapped supervisory conversational assistant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/imdc": {
      "post": {
        "summary": "Compute validated six-factor IMDC prognostic group",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kps_below_80": {
                    "type": "boolean"
                  },
                  "diagnosis_to_treatment_lt_1yr": {
                    "type": "boolean"
                  },
                  "hemoglobin_below_lln": {
                    "type": "boolean"
                  },
                  "corrected_calcium_above_uln": {
                    "type": "boolean"
                  },
                  "neutrophils_above_uln": {
                    "type": "boolean"
                  },
                  "platelets_above_uln": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kps_below_80",
                  "diagnosis_to_treatment_lt_1yr",
                  "hemoglobin_below_lln",
                  "corrected_calcium_above_uln",
                  "neutrophils_above_uln",
                  "platelets_above_uln"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score (0 to 6) and group (Favorable, Intermediate, Poor)"
          },
          "422": {
            "description": "Invalid or missing factors"
          }
        }
      }
    }
  }
}
